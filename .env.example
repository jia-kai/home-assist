# Copy to .env and replace this placeholder with your Music Assistant access token.
MUSIC_ASSISTANT_TOKEN=YOUR_ACCESS_TOKEN
# reSpeaker secrets used by the ESPHome build and encrypted native API.
RESPEAKER_WIFI_PASSWORD=YOUR_AP_PASSWORD
ESPHOME_API_KEY=YOUR_BASE64_32_BYTE_KEY
ESPHOME_OTA_PASSWORD=YOUR_OTA_PASSWORD
